#define FP_COMBA    2
/** Integrated modular squaring. */
#define FP_INTEG    3
/** Reuse multiplication for squaring. */
#define FP_MULTP    4
/** Chosen prime field multiplication method. */
#define FP_SQR   FP_@FP_SQR@

