#define FP_QUICK    2
/** Montgomery modular reduction. */
#define FP_MONTY    3
/** Use implementation provided by the lower layer. */
#define FP_LOWER    7
/** Chosen prime field reduction method. */
#define FP_RDC   FP_@FP_RDC@

/** Inversion by Fermat's Little Theorem. */
#define FP_BASIC    1
/** Binary inversion. */
#define FP_BINAR    2
