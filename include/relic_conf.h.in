/** Schoolbook squaring. */
#define BN_BASIC    1
/** Comba squaring. */
#define BN_COMBA    2
/** Reuse multiplication for squaring. */
#define BN_MULTP    4
/** Chosen multiple precision multiplication method. */
#define BN_SQR   BN_@BN_SQR@

/** Division modular reduction. */
#define BN_BASIC    1
