#ifndef RLC_CONF_H
#define RLC_CONF_H

/** Project name */
#define RLC_STRING	"@CMAKE_PROJECT_NAME@"
/** Project version. */
#define RLC_VERSION "@VERSION@"

/** Compiler used to build the library. */
#define RLC_CC "@CMAKE_C_COMPILER_ID@ @CMAKE_C_COMPILER_VERSION@"
/** Compiler flags used to build the library. */
#define RLC_FLAGS "@RLC_FLAGS@"

/** Debugging support. */
#cmakedefine RLC_DEBUG
/** Error handling support. */
#cmakedefine RLC_CHECK
/** Verbose error messages. */
#cmakedefine RLC_VERBS
/** Build documentation. */
#cmakedefine RLC_DOCUM
/** Remove unused code and tables of unselected algorithms. */
#cmakedefine RLC_STRIP
/** Build with printing disabled. */
#cmakedefine RLC_QUIET
/** Build with colored output. */
#cmakedefine RLC_COLOR
/** Build shared library. */
#cmakedefine RLC_SHLIB
/** Build static library. */
#cmakedefine RLC_STLIB
/** Width of window processing for exponentiation methods. */
#define RLC_WIDTH @RLC_WIDTH@
/** Width of precomputation table for fixed base exponentiation methods. */
#define RLC_DEPTH @RLC_DEPTH@

/** Number of times each test is ran. */
#define RLC_TESTS    @TESTS@
/** Number of times each benchmark is ran. */
#define RLC_BENCH    @BENCH@
/** Number of available cores. */
#define RLC_CORES    @CORES@

/** Atmel RLC_AVR ATMega128 8-bit architecture. */
#define RLC_AVR      1
/** MSP430 16-bit architecture. */
#define RLC_MSP      2
/** RLC_ARM 32-bit architecture. */
#define RLC_ARM      3
/** RLC_ARM 64-bit architecture. */
#define RLC_A64      4
/** Intel x86-compatible 32-bit architecture. */
#define RLC_X86      5
/** AMD64-compatible 64-bit architecture. */
#define RLC_X64      6
/** Chosen architecture. */
#cmakedefine RLC_ARCH	 RLC_@ARCH@

/** Size of word in this architecture. */
#define RLC_WSIZE    @WSIZE@

/** Byte boundary to align digit vectors. */
#define RLC_ALIGN    @ALIGN@

/** Build multiple precision integer module. */
#cmakedefine WITH_BN
/** Build prime field module. */
#cmakedefine WITH_FP
/** Build prime field extension module. */
#cmakedefine WITH_FPX
/** Build binary field module. */
#cmakedefine WITH_FB
/** Build prime elliptic curve module. */
#cmakedefine WITH_EP
/** Build prime field extension elliptic curve module. */
#cmakedefine WITH_EPX
/** Build binary elliptic curve module. */
#cmakedefine WITH_EB
/** Build elliptic Edwards curve module. */
#cmakedefine WITH_ED
/** Build elliptic curve cryptography module. */
#cmakedefine WITH_EC
/** Build pairings over prime curves module. */
#cmakedefine WITH_PP
/** Build pairing-based cryptography module. */
#cmakedefine WITH_PC
/** Build block ciphers. */
#cmakedefine WITH_BC
/** Build hash functions. */
#cmakedefine WITH_MD
/** Build cryptographic protocols. */
#cmakedefine WITH_CP
/** Build Multi-party computation primitives. */
#cmakedefine WITH_MPC

/** Easy C-only backend. */
#define RLC_EASY	 1
/** RLC_GMP backend. */
#define RLC_GMP      2
/** RLC_GMP constant-time backend. */
#define RLC_GMP_SEC  3
/** Arithmetic backend. */
#define RLC_ARITH    RLC_@ARITH@

/** Required precision in bits. */
#define BN_PRECI @BN_PRECI@
/** Number of Karatsuba steps. */
#define BN_KARAT @BN_KARAT@

/** Schoolbook multiplication. */
#define BN_BASIC    1
/** Comba multiplication. */
#define BN_COMBA    2
